{
  "name": "Windows in Codespace",
  "image": "://microsoft.com",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "portsAttributes": {
    "8006": {
      "label": "Windows noVNC",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "docker run -d --name windows -p 8006:8006 --device=/vhost=/dev/net/tun --device=/dev/kvm --cap-add NET_ADMIN -e VERSION=win11 dockur/windows"
}
